# DevFolio backend — environment variables
# Copy this file to .env and fill in real values. NEVER commit the real .env.

SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Whitelist your frontend origin(s) only — never CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database: leave as sqlite, or switch to postgres and fill the DB_* values
DB_ENGINE=sqlite
# DB_ENGINE=postgres
# DB_NAME=devfolio
# DB_USER=devfolio
# DB_PASSWORD=changeme
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Email (console backend in dev — signal prints to the terminal)
DEFAULT_FROM_EMAIL=noreply@devfolio.local
OWNER_NOTIFY_EMAIL=owner@devfolio.local
